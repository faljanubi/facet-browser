<Project>
  <!-- Applies to every project in this tree, including the bundled foobar2000 SDK projects:
       makes the bundled WTL headers visible and keeps build output out of the source folders. -->
  <PropertyGroup>
    <IncludePath>$(MSBuildThisFileDirectory)third_party\wtl\include;$(IncludePath)</IncludePath>
  </PropertyGroup>
</Project>
