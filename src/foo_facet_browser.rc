#include "resource.h"
#include <winres.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

// Preferences pages (Media Library > Facet Browser and its Columns / Filters / Statistics pages).
// Child dialogs hosted by foobar2000, which sizes them to its page area; Layout() in prefs.cpp
// fits the controls to that size.
IDD_PREFS DIALOGEX 0, 0, 332, 288
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Library selection",IDC_GRP_LIB,0,0,332,52
    LTEXT           "Playlist:",IDC_LBL_SELPL,7,15,40,8
    EDITTEXT        IDC_SELPL,52,13,273,13,ES_AUTOHSCROLL
    LTEXT           "Sort pattern:",IDC_LBL_SORT,7,33,44,8
    EDITTEXT        IDC_SORT,52,31,273,13,ES_AUTOHSCROLL
    LTEXT           "",IDC_HELP_GENERAL,0,60,332,60
END

IDD_PREFS_LIST DIALOGEX 0, 0, 332, 288
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "",IDC_GRP_LIST,0,0,332,288
    LISTBOX         IDC_LIST,7,12,110,250,LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Add new",IDC_ADD,7,268,38,13
    PUSHBUTTON      "Remove",IDC_REMOVE,47,268,34,13
    PUSHBUTTON      "Up",IDC_UP,83,268,16,13
    PUSHBUTTON      "Dn",IDC_DOWN,101,268,16,13
    LTEXT           "Name:",IDC_LBL_NAME,124,14,30,8
    EDITTEXT        IDC_NAME,158,12,167,13,ES_AUTOHSCROLL
    LTEXT           "",IDC_LBL_VALUE,124,31,30,8
    EDITTEXT        IDC_VALUE,158,29,167,13,ES_AUTOHSCROLL
    LTEXT           "Combine:",IDC_LBL_COMBINE,124,48,30,8
    COMBOBOX        IDC_COMBINE,158,46,80,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "",IDC_HELP_LIST,124,66,201,100
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,3,0
 PRODUCTVERSION 1,0,3,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Faris Aljanubi"
            VALUE "FileDescription", "Facet Browser - foobar2000 component"
            VALUE "FileVersion", "1.0.3"
            VALUE "InternalName", "foo_facet_browser"
            VALUE "LegalCopyright", "\xa9 2026 Faris Aljanubi"
            VALUE "OriginalFilename", "foo_facet_browser.dll"
            VALUE "ProductName", "Facet Browser"
            VALUE "ProductVersion", "1.0.3"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
